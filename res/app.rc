#include <winresrc.h>

#define YAMI_VERSION_MAJOR 1
#define YAMI_VERSION_MINOR 1
#define YAMI_VERSION_PATCH 0

#define YAMI_STRINGIFY(x) #x
#define YAMI_VERSION_STRING(major, minor, patch) YAMI_STRINGIFY(major) "." YAMI_STRINGIFY(minor) "." YAMI_STRINGIFY(patch)
#define YAMI_VERSION YAMI_VERSION_MAJOR,YAMI_VERSION_MINOR,YAMI_VERSION_PATCH,0
#define YAMI_VERSION_TEXT YAMI_VERSION_STRING(YAMI_VERSION_MAJOR, YAMI_VERSION_MINOR, YAMI_VERSION_PATCH)

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION YAMI_VERSION
PRODUCTVERSION YAMI_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "MSOB7YY"
      VALUE "FileDescription", "Yami"
      VALUE "FileVersion", YAMI_VERSION_TEXT
      VALUE "InternalName", "Yami"
      VALUE "LegalCopyright", "Copyright (c) 2026 MSOB7YY"
      VALUE "OriginalFilename", "Yami.exe"
      VALUE "ProductName", "Yami"
      VALUE "ProductVersion", YAMI_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
